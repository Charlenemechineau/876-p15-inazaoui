{% extends 'admin.html.twig' %}

{% block title %}Gestion des invités{% endblock %}

{% block admin %}

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Gestion des invités</h1>

            <a href="{{ path('admin_guest_new') }}" class="btn btn-primary">
                Ajouter un invité
            </a>
        </div>

        {% if guests is empty %}
            <div class="alert alert-info">
                Aucun invité enregistré.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for guest in guests %}
                        <tr>
                            <td>{{ guest.name }}</td>
                            <td>{{ guest.email }}</td>

                            <td>
                                {% if guest.blocked %}
                                    <span class="badge text-bg-danger">Bloqué</span>
                                {% else %}
                                    <span class="badge text-bg-success">Actif</span>
                                {% endif %}
                            </td>

                            <td class="text-center">
                                <form
                                        method="post"
                                        action="{{ path('admin_guest_toggle_block', { id: guest.id }) }}"
                                        class="d-inline"
                                >
                                    <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('toggle-block-' ~ guest.id) }}"
                                    >

                                    <button
                                            type="submit"
                                            class="btn btn-sm {{ guest.blocked ? 'btn-success' : 'btn-warning' }}"
                                    >
                                        {{ guest.blocked ? 'Débloquer' : 'Bloquer' }}
                                    </button>
                                </form>

                                <form
                                        method="post"
                                        action="{{ path('admin_guest_delete', { id: guest.id }) }}"
                                        class="d-inline"
                                        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet invité ainsi que tous ses médias ?');"
                                >
                                    <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete-guest-' ~ guest.id) }}"
                                    >

                                    <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                    >
                                        Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}