{% extends 'admin.html.twig' %}

{% block title %}Ajouter un invité{% endblock %}

{% block admin %}
    <div class="container py-5">
        <h1 class="mb-4">Ajouter un invité</h1>

        {{ form_start(form) }}

        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        {{ form_row(form.description) }}

        <button type="submit" class="btn btn-primary">
            Ajouter
        </button>

        <a href="{{ path('admin_guest_index') }}" class="btn btn-secondary">
            Annuler
        </a>

        {{ form_end(form) }}
    </div>
{% endblock %}